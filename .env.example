# Copy to .env for local overrides. Do not commit .env or any secrets.
MUSIC_GATHERINGS_APP_ENV=development
# Published host ports only; container ports and private service URLs stay fixed.
MUSIC_GATHERINGS_FRONTEND_PORT=3000
MUSIC_GATHERINGS_BACKEND_PORT=8000
# Local E2E iteration only: raise the login throttle so repeated Playwright
# runs on one volume do not trip it (CI uses a fresh volume + defaults).
# E2E_LOGIN_MAX_ATTEMPTS=100

# LRCLIB replaces Genius; no API key or OAuth needed.
# Personal local lyric imports are enabled. For deployments without established
# storage/sharing rights, disable storage to import references only.
LRCLIB_ALLOW_STORAGE=true
LRCLIB_REQUESTS_PER_MINUTE=20
LRCLIB_MIN_INTERVAL_SECONDS=0.5

# Legacy Genius settings below are no longer used; existing local values can be
# removed. Do not copy real credentials into this example file.
# Get genius keys from https://genius.com/api-clients
GENIUS_API_CLIENT_ID=nope
GENIUS_API_CLIENT_SECRET=nope
GENIUS_ACCESS_TOKEN=nope
